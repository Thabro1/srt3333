local Fonts = {}; do
    local function RegisterFont(Name, Weight, Style, Asset)
        local directory = "BusterUI" -- Define directory locally
        local HttpService = game:GetService("HttpService")
        
        if not isfolder(directory) then
            makefolder(directory)
        end
        if not isfolder(directory.."/assets") then
            makefolder(directory.."/assets")
        end
        if not isfolder(directory.."/fonts") then
            makefolder(directory.."/fonts")
        end
        
        if isfile(directory.."/assets/"..Asset.Id) then
            delfile(directory.."/assets/"..Asset.Id)
        end

        writefile(directory.."/assets/"..Asset.Id, Asset.Font)

        local Data = {
            name = Name,
            faces = {
                {
                    Name = "Normal",
                    weight = Weight,
                    style = Style,
                    assetId = getcustomasset(directory.."/assets/"..Asset.Id),
                },
            },
        }

        writefile(directory.."/fonts/"..Name .. ".font", HttpService:JSONEncode(Data))

        return getcustomasset(directory.."/fonts/"..Name .. ".font");
    end
    
