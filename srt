local TEXTURE = {77287274560005}

local DEFAULTS = {
    BulletHoleEnabled = true,
    BulletHoleSize = 12,
    BulletHoleVisibleTime = 100,
    BulletHoleFadeTime = 12,
    BulletHoleTexture = TEXTURE,
}

local state = {
    enabled = false,
    size = DEFAULTS.BulletHoleSize,
    visibleTime = DEFAULTS.BulletHoleVisibleTime,
    fadeTime = DEFAULTS.BulletHoleFadeTime,

    backups = setmetatable({}, { __mode = "k" }),
}

local function backupIfNeeded(t)
    if state.backups[t] then return end

    local inner = rawget(t, 1)
    state.backups[t] = {
        BulletHoleEnabled = rawget(t, "BulletHoleEnabled"),
        BulletHoleSize = rawget(t, "BulletHoleSize"),
        BulletHoleVisibleTime = rawget(t, "BulletHoleVisibleTime"),
        BulletHoleFadeTime = rawget(t, "BulletHoleFadeTime"),
        BulletHoleTexture = rawget(t, "BulletHoleTexture"),
        inner1 = (typeof(inner) == "table") and rawget(inner, 1) or nil,
    }
end

local function restore(t)
    local b = state.backups[t]
    if not b then return end

    rawset(t, "BulletHoleEnabled", b.BulletHoleEnabled)
    rawset(t, "BulletHoleSize", b.BulletHoleSize)
    rawset(t, "BulletHoleVisibleTime", b.BulletHoleVisibleTime)
    rawset(t, "BulletHoleFadeTime", b.BulletHoleFadeTime)
    rawset(t, "BulletHoleTexture", b.BulletHoleTexture)

    local inner = rawget(t, 1)
    if typeof(inner) == "table" then
        rawset(inner, 1, b.inner1)
    end
end

local function setBulletHole(t)
    if typeof(t) ~= "table" or not rawget(t, "BulletHoleEnabled") then return end

    backupIfNeeded(t)

    rawset(t, "BulletHoleEnabled", true)
    rawset(t, "BulletHoleSize", state.size)
    rawset(t, "BulletHoleVisibleTime", state.visibleTime)
    rawset(t, "BulletHoleFadeTime", state.fadeTime)
    rawset(t, "BulletHoleTexture", TEXTURE)

    local inner = rawget(t, 1)
    if typeof(inner) == "table" then
        rawset(inner, 1, TEXTURE)
    end
end

local function applyToAll()
    for _, v in getgc(true) do
        if typeof(v) == "table" then
            pcall(function()
                setBulletHole(v)
                for _, k in {7, 8} do
                    setBulletHole(rawget(v, k))
                end
            end)
        end
    end
end

local function restoreAll()
    for t in pairs(state.backups) do
        pcall(function()
            restore(t)
        end)
    end
end



