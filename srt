local function StopFEEmote()
    FEEmoteLoopToken = FEEmoteLoopToken + 1
    if FEEmoteTrack then
        pcall(function()
            FEEmoteTrack:Stop()
        end)
        FEEmoteTrack = nil
    end
end

local function PlayFEEmote(name)
    local emote = FEEmoteMap[name]
    if not emote then return end

    StopFEEmote()

    local player = Players.LocalPlayer
    local character = player.Character or player.CharacterAdded:Wait()
    local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid")
    local animator = humanoid:FindFirstChildOfClass("Animator") or humanoid:WaitForChild("Animator")

    local animation = Instance.new("Animation")
    animation.AnimationId = "rbxassetid://" .. tostring(emote.id)

    local loadAnimation = animator:LoadAnimation(animation)
    loadAnimation:Play()
    loadAnimation:AdjustSpeed(emote.speed or 1)
    loadAnimation.TimePosition = emote.timepos or 0
    loadAnimation.Looped = true

    FEEmoteTrack = loadAnimation
    local token = FEEmoteLoopToken

    task.spawn(function()
        while task.wait(0.05) do
            if token ~= FEEmoteLoopToken then break end
            if not loadAnimation.IsPlaying then break end
        end

        if FEEmoteTrack == loadAnimation then
            StopFEEmote()
        end
    end)
end

