local function collectItems(folder)
    local items = {}
    if folder then
        for _, item in ipairs(folder:GetChildren()) do
            table.insert(items, item.Name)
        end
    end
    return items
end

local categories = {
    Shirts = collectItems(clothingList:FindFirstChild("Shirts")),
    Pants = collectItems(clothingList:FindFirstChild("Pants")),
    Hats = collectItems(woody:FindFirstChild("Hats")),
    Glasses = collectItems(woody:FindFirstChild("Glasses")),
    Masks = collectItems(woody:FindFirstChild("Masks")),
    Shiestys = collectItems(woody:FindFirstChild("Shiestys"))
}

local function randomFrom(tbl)
    if not tbl or #tbl == 0 then
        return nil
    end
    return tbl[math.random(1, #tbl)]
end

