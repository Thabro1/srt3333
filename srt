            BulletParticleTexture = v.BulletParticleTexture,
            BulletTracerEnabled = v.BulletTracerEnabled,
            BulletTrailEnabled = v.BulletTrailEnabled
        }
    end
end

local function restore_original(v)
    local o = original_values[v]
    if o then
        for k, vv in pairs(o) do
            v[k] = vv
        end
    end
end

local function apply_mod()
    for _, v in getgc(true) do
        if typeof(v) == "table" and rawget(v, "BulletSpeed") then
            store_original(v)
            v.BulletSpeed = mod_speed
            v.DropGravity = mod_gravity

            v.BulletMeshEnabled = false
            v.BulletMeshID = mod_mesh_id
            v.BulletTextureID = mod_texture_id
            v.BulletMeshScale = mod_mesh_scale
            v.BulletSize = mod_size
            v.BulletTransparency = 1
            v.BulletMaterial = mod_material

            v.BulletLightEnabled = mod_light_enabled
            v.BulletLightBrightness = mod_light_brightness
            v.BulletLightRange = mod_light_range
            if v.BulletLightColor then
                v.BulletLightColor = mod_light_color
            end

            v.BulletParticleEnaled = mod_particle_enabled
            if v.BulletParticleColor then
                v.BulletParticleColor = mod_particle_color
            end
            v.BulletParticleSize = mod_particle_size
            v.BulletParticleRate = mod_particle_rate
            v.BulletParticleLifetime = mod_particle_lifetime
            v.BulletParticleSpeed = mod_particle_speed
            v.BulletParticleTexture = mod_particle_texture

            v.BulletTracerEnabled = mod_tracer_enabled
            v.BulletTrailEnabled = mod_trail_enabled
        end
    end
end

local function restore_mod()
    for _, v in getgc(true) do
        if typeof(v) == "table" and rawget(v, "BulletSpeed") then
            restore_original(v)
        end
