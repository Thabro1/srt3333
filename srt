local original_values = {}

local function store_original(v)
    if not original_values[v] then
        original_values[v] = {
            BulletSpeed = v.BulletSpeed,
            DropGravity = v.DropGravity,
            BulletMeshEnabled = v.BulletMeshEnabled,
            BulletMeshID = v.BulletMeshID,
            BulletTextureID = v.BulletTextureID,
