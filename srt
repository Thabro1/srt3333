local Cooldown = false
local AutoSafeDupe = false

DupeSection:Toggle({
    Name = "Auto Safe Dupe",
    Flag = "AutoSafeDupe_TheBronx",
    Default = false,
    callback = function(state)
        AutoSafeDupe = state

        task.spawn(function()

            local Players = game:GetService("Players")
            local ReplicatedStorage = cloneref(game:GetService("ReplicatedStorage"))
            local Player = Players.LocalPlayer

            while AutoSafeDupe do

                if Cooldown then
                    task.wait(0.1)
                    continue
                end

                Cooldown = true

                local char = Player.Character or Player.CharacterAdded:Wait()
                local tool = char:FindFirstChildOfClass("Tool")

                if not tool then
                    Library.Notifications:Create({Name = "No Tool Found — Equip One", LifeTime = 4})
                    Cooldown = false
                    break
                end

                local ToolName = tool.Name

                Library.Notifications:Create({Name = "Safe Dupe Running For: " .. ToolName, LifeTime = 4})

                getgenv().TeleportSettings = { Speed = 0.25 }
                getgenv().StoreDuped = true

                local function enableSwim()
                    getgenv().SwimMethod = true
                    task.wait(1)
                end

                local function disableSwim()
                    getgenv().SwimMethod = false
                end

                local function BypassTp(cf)
                    local char = Player.Character
                    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                    enableSwim()
                    task.wait(getgenv().TeleportSettings.Speed)
                    char.HumanoidRootPart.CFrame = cf + Vector3.new(2,0,0)
                    task.delay(0.25, disableSwim)
                end

                local function GetSafe()
                    local safe = nil
                    pcall(function()
                        safe = workspace:WaitForChild("HomeDoorSS"):WaitForChild("HomeDoor"):WaitForChild("Safe")
                    end)
                    return safe
                end

                local function SafeDupeOnce(toolName)
                    local Character = Player.Character
                    if not Character or not toolName then return end

                    local InventoryRemote = ReplicatedStorage:WaitForChild("Inventory")
                    local BackpackRemote = ReplicatedStorage:WaitForChild("BackpackRemote")

                    local Safe = GetSafe()
                    if not Safe then return end

                    Character.Humanoid:UnequipTools()

                    task.spawn(function()
                        BackpackRemote:InvokeServer("Store", toolName)
                    end)

                    task.spawn(function()
                        InventoryRemote:FireServer("Change", toolName, "Backpack", Safe)
                    end)

                    task.wait(2)

                    BackpackRemote:InvokeServer("Grab", toolName)

                    if not getgenv().StoreDuped then
                        InventoryRemote:FireServer("Change", toolName, "Inv", Safe)
                    end
                end

                local Safe = GetSafe()
                if not Safe then
                    Library.Notifications:Create({Name = "Safe Not Found", LifeTime = 4})
                    Cooldown = false
                    break
                end

                local originalCFrame = char:WaitForChild("HumanoidRootPart").CFrame

                local safePart
                for _, v in pairs(Safe:GetChildren()) do
                    if v:IsA("BasePart") then
                        safePart = v
                        break
                    end
                end

                if not safePart then
                    Library.Notifications:Create({Name = "Safe Part Missing", LifeTime = 4})
                    Cooldown = false
                    break
                end

                -- TELEPORT TO SAFE
                BypassTp(safePart.CFrame + Vector3.new(0, 0.5, 0))

                task.wait(1)

                SafeDupeOnce(ToolName)

                task.wait(1)

                -- TELEPORT BACK
                BypassTp(originalCFrame)

                -- RE‑EQUIP TOOL
                task.wait(0.5)
                local backpackTool = Player.Backpack:FindFirstChild(ToolName)
                if backpackTool then
                    Player.Character.Humanoid:EquipTool(backpackTool)
                end

                Library.Notifications:Create({Name = "Safe Dupe Loop Finished", LifeTime = 3})

                Cooldown = false

                task.wait(3)
            end

            if not AutoSafeDupe then
                Library.Notifications:Create({Name = "Auto Safe Dupe Stopped", LifeTime = 3})
            end

        end)
    end
})


