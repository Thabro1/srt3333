    Flag = "FarmTrash_TheBronx",
    Default = false,
    callback = function(value)
        Config.TheBronx.Farms.FarmTrash = value
        getgenv().TrashLoopRunning = value

        if not value then return end

        task.spawn(function()
            while getgenv().TrashLoopRunning do
                gui = player:FindFirstChild("PlayerGui")

                if gui and gui:FindFirstChild("Bronx PAWNING") then
                    list = gui["Bronx PAWNING"].Frame.Holder.List

                    for _,frame in ipairs(list:GetChildren()) do
                        if not getgenv().TrashLoopRunning then break end

